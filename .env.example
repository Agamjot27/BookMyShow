# Copy to .env at repository root. Local development only.
# Never commit .env — it is gitignored. This file contains placeholder values only.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bookmyshow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=bookmyshow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookmyshow:local-development-only@localhost:5432/bookmyshow

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Set both to enable in-process MemoryStore fallback for local dev without Redis.
# Keep REDIS_ALLOW_MEMORY_FALLBACK=false for any shared or multi-process environment;
# MemoryStore state is process-local and does not provide real atomicity across instances.
NODE_ENV=development
REDIS_ALLOW_MEMORY_FALLBACK=false

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Replace with a cryptographically random secret of at least 32 characters.
# Example (PowerShell): -join ((1..48)|%{[char](Get-Random -Min 33 -Max 127)})
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=ticket-booking-api
JWT_AUDIENCE=ticket-booking-web
JWT_EXPIRES_IN_SECONDS=3600

# ── Seed accounts ─────────────────────────────────────────────────────────────
# Auth is OTP-only — no passwords are required or stored for seed accounts.
# SEED_ADMIN_EMAIL is upserted with role='admin'. After running db:seed, log in
# via the normal OTP flow with this email to receive admin access.
# Reruns are idempotent: the role is re-confirmed each time.
SEED_ADMIN_EMAIL=admin@example.test
SEED_USER_EMAIL=user@example.test

# ── SMTP (Gmail App Password) ─────────────────────────────────────────────────
# OTP emails are sent via Gmail SMTP. Do NOT use your Google account password here.
# Steps:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" / "Other") and paste it below.
SMTP_USER=your@gmail.com
SMTP_PASS=

# ── Connection pool / timeouts ────────────────────────────────────────────────
PG_POOL_MAX=10
PG_LOCK_TIMEOUT_MS=1000
PG_STATEMENT_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=1000

# ── Business limits (read by backend; not configurable in frontend) ───────────
SEAT_HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=6
