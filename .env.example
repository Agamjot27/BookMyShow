# Copy to .env at repository root. Local development only.
POSTGRES_USER=bookmyshow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=bookmyshow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookmyshow:local-development-only@localhost:5432/bookmyshow
# Memory fallback requires both settings; keep disabled for shared/multi-instance environments.
NODE_ENV=development
REDIS_ALLOW_MEMORY_FALLBACK=false
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=ticket-booking-api
JWT_AUDIENCE=ticket-booking-web
JWT_EXPIRES_IN_SECONDS=3600
# Local seed credentials. Set strong passwords before running db:seed.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@example.test
SEED_USER_PASSWORD=
# Gmail SMTP for OTP emails. Use a Gmail App Password (not your account password).
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=your@gmail.com
SMTP_PASS=
PG_POOL_MAX=10
PG_LOCK_TIMEOUT_MS=1000
PG_STATEMENT_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=1000
# Reserved for future business implementation
SEAT_HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=6
